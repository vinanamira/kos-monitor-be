# Salin jadi .env lalu ubah seperlunya. Semua nilai di bawah adalah default.

# Database: SQLite (default, tanpa setup) atau MySQL Laragon:
# DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/kosmonitor   (pip install pymysql)
DATABASE_URL=sqlite:///./kosmonitor.db

# MQTT (harus sama dengan ESP32 & dashboard)
MQTT_ENABLED=true
MQTT_BROKER=broker.emqx.io
MQTT_PORT=8083
MQTT_TRANSPORT=websockets
MQTT_WS_PATH=/mqtt
TOPIC_PREFIX=kosdemo/icha-kos

# Batas keras (di luar ini data ditolak)
MAX_PAYLOAD_BYTES=2048
VOLTAGE_MIN_V=0
VOLTAGE_MAX_V=300
CURRENT_MAX_A=30
POWER_MAX_W=9000
ADC_MAX=4095
POWER_TOLERANCE_PCT=5
POWER_TOLERANCE_ABS_W=1
MIN_INTERVAL_S=0.2

# Batas lunak (data lolos dengan peringatan)
VOLTAGE_NOMINAL_MIN_V=198
VOLTAGE_NOMINAL_MAX_V=231
DAYA_KONTRAK_VA=1300
SPIKE_POWER_DELTA_W=1000

# Energi & biaya
TARIF_PER_KWH=1444.70
ENERGY_MAX_GAP_S=60
DEVICE_OFFLINE_AFTER_S=30

# Keep-alive: di Render otomatis ping RENDER_EXTERNAL_URL/health tiap 10 menit
KEEP_ALIVE_ENABLED=true
# KEEP_ALIVE_URL=https://contoh.onrender.com/health
KEEP_ALIVE_INTERVAL_S=600
